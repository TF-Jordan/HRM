worker_processes auto;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 4096;
    server_tokens off;
    underscores_in_headers on;

    log_format gateway '$remote_addr - $remote_user [$time_local] '
                       '"$request" $status $body_bytes_sent '
                       '"$http_referer" "$http_user_agent" '
                       'req_id=$request_id upstream=$upstream_addr rt=$request_time urt=$upstream_response_time';

    access_log /var/log/nginx/access.log gateway;
    error_log /var/log/nginx/error.log warn;

    map $http_x_request_id $external_request_id {
        default $http_x_request_id;
        ""      $request_id;
    }

    map $http_x_tenant_id $tenant_limit_key {
        default $http_x_tenant_id;
        ""      $binary_remote_addr;
    }

    limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${IWM_GATEWAY_RATE_LIMIT};
    limit_req_zone $tenant_limit_key zone=api_per_tenant:20m rate=${IWM_GATEWAY_TENANT_RATE_LIMIT};
    limit_conn_zone $binary_remote_addr zone=api_conn_per_ip:10m;
    limit_conn_zone $tenant_limit_key zone=api_conn_per_tenant:20m;
    resolver 127.0.0.11 ipv6=off valid=10s;
    map $request_uri $iwm_api_upstream {
        default http://${IWM_GATEWAY_UPSTREAM_HOST}:${IWM_GATEWAY_UPSTREAM_PORT};
    }
    map $request_uri $iwm_management_upstream {
        default http://${IWM_GATEWAY_UPSTREAM_HOST}:${IWM_GATEWAY_MANAGEMENT_PORT};
    }

    server {
        listen ${IWM_GATEWAY_HTTP_PORT};
        server_name _;
        client_max_body_size ${IWM_GATEWAY_CLIENT_MAX_BODY_SIZE};

        location = /healthz {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_pass $iwm_management_upstream/actuator/health;
        }

        location = /readyz {
            return 404;
        }

        location ^~ /actuator/ {
            return 404;
        }

        location = / {
            return 302 /swagger-ui.html;
        }

        location = /swagger-ui.html {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location ^~ /swagger-ui/ {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location ^~ /v3/api-docs {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location ^~ /webjars/ {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location /api/ {
            limit_req zone=api_per_ip burst=${IWM_GATEWAY_RATE_LIMIT_BURST} nodelay;
            limit_req zone=api_per_tenant burst=${IWM_GATEWAY_TENANT_RATE_LIMIT_BURST} nodelay;
            limit_conn api_conn_per_ip ${IWM_GATEWAY_CONNECTION_LIMIT};
            limit_conn api_conn_per_tenant ${IWM_GATEWAY_TENANT_CONNECTION_LIMIT};

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            add_header X-IWM-Gateway-RateLimit-Scope "tenant" always;
            add_header X-IWM-Gateway-Tenant-RateLimit "${IWM_GATEWAY_TENANT_RATE_LIMIT}" always;

            # Never trust externally supplied identity headers.
            proxy_set_header X-User-Id "";
            proxy_set_header X-Actor-Id "";
            proxy_set_header X-Management-Api-Key "";

            proxy_connect_timeout 5s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_pass $iwm_api_upstream;
        }

        location / {
            return 404;
        }
    }

    server {
        listen ${IWM_GATEWAY_TLS_PORT} ssl;
        http2 on;
        server_name _;
        client_max_body_size ${IWM_GATEWAY_CLIENT_MAX_BODY_SIZE};

        ssl_certificate     ${IWM_GATEWAY_TLS_CERT_PATH};
        ssl_certificate_key ${IWM_GATEWAY_TLS_KEY_PATH};
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location = /healthz {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_pass $iwm_management_upstream/actuator/health;
        }

        location = /readyz {
            return 404;
        }

        location ^~ /actuator/ {
            return 404;
        }

        location = / {
            return 302 /swagger-ui.html;
        }

        location = /swagger-ui.html {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location ^~ /swagger-ui/ {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location ^~ /v3/api-docs {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location ^~ /webjars/ {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            proxy_pass $iwm_api_upstream;
        }

        location /api/ {
            limit_req zone=api_per_ip burst=${IWM_GATEWAY_RATE_LIMIT_BURST} nodelay;
            limit_req zone=api_per_tenant burst=${IWM_GATEWAY_TENANT_RATE_LIMIT_BURST} nodelay;
            limit_conn api_conn_per_ip ${IWM_GATEWAY_CONNECTION_LIMIT};
            limit_conn api_conn_per_tenant ${IWM_GATEWAY_TENANT_CONNECTION_LIMIT};

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Request-Id $external_request_id;
            add_header X-IWM-Gateway-RateLimit-Scope "tenant" always;
            add_header X-IWM-Gateway-Tenant-RateLimit "${IWM_GATEWAY_TENANT_RATE_LIMIT}" always;

            proxy_set_header X-User-Id "";
            proxy_set_header X-Actor-Id "";
            proxy_set_header X-Management-Api-Key "";

            proxy_connect_timeout 5s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_pass $iwm_api_upstream;
        }

        location / {
            return 404;
        }
    }
}
