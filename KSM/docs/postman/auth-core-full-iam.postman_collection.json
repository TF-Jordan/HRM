  "item": [
    {
      "name": "00 - OIDC Discovery Metadata",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/.well-known/openid-configuration",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ".well-known",
            "openid-configuration"
          ]
        },
        "description": "Central provider metadata. Run first to validate the OIDC provider is exposed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OIDC metadata is exposed', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property('token_endpoint');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Issue Captcha",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Client-Id",
            "value": "{{clientId}}"
          },
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/captcha",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "captcha"
          ]
        },
        "description": "Creates a captcha challenge. In dev/test the answerPreview is returned so the flow is executable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Captcha issued', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('authCoreCaptchaToken', json.data.captchaToken);",
              "pm.collectionVariables.set('authCoreCaptchaAnswer', json.data.answerPreview);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Verify Captcha",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Client-Id",
            "value": "{{clientId}}"
          },
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{tenantId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"captchaToken\": \"{{authCoreCaptchaToken}}\",\n  \"answer\": \"{{authCoreCaptchaAnswer}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/captcha/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "captcha",
            "verify"
          ]
        },
        "description": "Converts the solved captcha challenge into a captchaVerificationToken usable by sign-up."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Captcha verified', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('authCoreCaptchaVerificationToken', json.data.captchaVerificationToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Sign Up Business Freelance User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Client-Id",
            "value": "{{clientId}}"
          },
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{tenantId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Full\",\n  \"lastName\": \"Auth\",\n  \"tenantId\": \"{{tenantId}}\",\n  \"username\": \"{{authCoreUsername}}\",\n  \"email\": \"{{authCoreEmail}}\",\n  \"phoneNumber\": \"{{authCorePhone}}\",\n  \"password\": \"{{authCorePassword}}\",\n  \"captchaVerificationToken\": \"{{authCoreCaptchaVerificationToken}}\",\n  \"accountType\": \"BUSINESS\",\n  \"businessType\": \"FREELANCE\",\n  \"onboardingData\": {\n    \"businessName\": \"Full Auth Freelance\",\n    \"deliveryAddress\": \"Douala\",\n    \"niu\": \"NIU-POSTMAN-001\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/sign-up",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "sign-up"
          ]
        },
        "description": "Creates a typed BUSINESS/FREELANCE account with strong password and onboarding payload."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User signed up', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('authCoreAccessToken', json.data.accessToken);",
              "if (json.data.sharedSession && json.data.sharedSession.token) {",
              "  pm.collectionVariables.set('authCoreSharedSessionToken', json.data.sharedSession.token);",
              "}",
              "pm.test('Typed onboarding saved', function () {",
              "  pm.expect(json.data.accountType).to.eql('BUSINESS');",
              "  pm.expect(json.data.businessType).to.eql('FREELANCE');",
              "});"
            ]
          }
        }
      ]
    },
