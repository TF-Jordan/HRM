        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"BUSINESS\",\n  \"businessType\": \"ORGANIZATION\",\n  \"step\": 4,\n  \"status\": \"COMPLETED\",\n  \"data\": {\n    \"businessName\": \"Full Organization\",\n    \"businessOwnerName\": \"Full Auth\",\n    \"niu\": \"NIU-FULL\",\n    \"logo\": \"logo.png\",\n    \"headerPhoto\": \"header.png\"\n  }\n}"
