    },
    {
      "name": "13 - OIDC UserInfo From Shared SSO Session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authCoreSharedSessionToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/oauth2/userinfo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "oauth2",
            "userinfo"
          ]
        },
        "description": "Reads central SSO contexts from the sharedSession.token returned by login/sign-up."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('SSO userinfo returned', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (json.contexts && json.contexts.length > 0) {",
              "  pm.collectionVariables.set('authCoreOidcContextId', json.contexts[0].contextId);",
              "  if (json.contexts[0].organizations && json.contexts[0].organizations.length > 0) {",
              "    pm.collectionVariables.set('authCoreOidcOrganizationId', json.contexts[0].organizations[0].organizationId);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - OIDC Token Exchange",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange",
              "type": "text"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:jwt",
              "type": "text"
            },
            {
              "key": "subject_token",
              "value": "{{authCoreSharedSessionToken}}",
              "type": "text"
            },
            {
              "key": "context_id",
              "value": "{{authCoreOidcContextId}}",
              "type": "text"
            },
            {
              "key": "organization_id",
              "value": "{{authCoreOidcOrganizationId}}",
              "type": "text",
              "disabled": true
            },
            {
              "key": "service_code",
              "value": "{{oidcServiceCode}}",
              "type": "text"
            },
            {
              "key": "requested_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{oidcClientId}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{oidcClientSecret}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/oauth2/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "oauth2",
            "token"
          ]
        },
        "description": "Exchanges the central shared SSO token for a service-scoped access token. Enable organization_id if the selected context has an organization."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OIDC token exchanged', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('authCoreOidcAccessToken', json.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - OIDC UserInfo From Exchanged Access Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authCoreOidcAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/oauth2/userinfo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "oauth2",
            "userinfo"
          ]
        },
        "description": "Validates the service-scoped access token and returns JWT/OIDC user claims."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OIDC access token userinfo returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property('serviceCode');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - OIDC Introspect Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "token",
              "value": "{{authCoreOidcAccessToken}}",
              "type": "text"
            },
            {
              "key": "token_type_hint",
              "value": "access_token",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{oidcClientId}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{oidcClientSecret}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/oauth2/introspect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "oauth2",
            "introspect"
          ]
        },
        "description": "RFC 7662 introspection for the exchanged access token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OIDC token is active', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().active).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
