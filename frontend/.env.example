# Frontend-only env vars.
# A root `.env` at the repository root holds the shared infra/backend block too —
# copy `<repo>/.env.example` into `<repo>/.env` for the full picture.
# Variables defined here override the root ones when starting the Next.js app.

# ──────────────────────────────────────────────────────────────────────────
# KSM Backend (BFF server-only secrets — never exposed to the browser)
# ──────────────────────────────────────────────────────────────────────────
KSM_BASE_URL=http://localhost:8080
# Matches the ClientApplication seeded by V68__hrm_demo_seed.sql.
# In production, register a new ClientApplication via KSM and rotate this secret.
KSM_CLIENT_ID=hrm-frontend
KSM_API_KEY=hrm-bff-dev-secret-2024

# ──────────────────────────────────────────────────────────────────────────
# Session — generate a 32-bytes-min secret: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=hrm_session
SESSION_SECRET=replace-with-32-bytes-minimum-secret-here-please
SESSION_TTL_SECONDS=3600

# ──────────────────────────────────────────────────────────────────────────
# Email — sender of the welcome / notification mails.
# EMAIL_PROVIDER: "none" (dev log), "smtp" (nodemailer), "resend" (Resend API)
# EMAIL_FROM    : visible "From:" header — use "Name <inbox@domain>" format.
#                 Domain MUST be verified by your provider for smtp / resend.
# EMAIL_REPLY_TO: optional Reply-To header.
# ──────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=none

# SMTP backend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend backend
RESEND_API_KEY=

EMAIL_FROM="HR Core <noreply@hrcore.local>"
EMAIL_REPLY_TO=

# ──────────────────────────────────────────────────────────────────────────
# Public
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=HR Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=XAF
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en

# Logs
LOG_LEVEL=info
NODE_ENV=development
