# ============================================================
# HRM Frontend — Environment variables example
# Copy this file to .env.local and adjust values for your env.
# Server-only secrets must NEVER be prefixed with NEXT_PUBLIC_.
# ============================================================

# --- KSM backend (server-only) --------------------------------
KSM_BASE_URL=http://localhost:8080
KSM_CLIENT_ID=dev-platform-backend
KSM_API_KEY=dev-api-key
KSM_REQUEST_TIMEOUT_MS=15000

# --- Session signing (server-only) ----------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-48-bytes-random-base64-string
SESSION_COOKIE_NAME=__Host-hrm_session
WORKSPACE_COOKIE_NAME=__Host-hrm_workspace
CSRF_COOKIE_NAME=hrm_csrf
SESSION_TTL_SECONDS=3600

# --- Logger ---------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development

# --- Public app config ---------------------------------------
NEXT_PUBLIC_APP_NAME="HR Core"
NEXT_PUBLIC_DEFAULT_CURRENCY=XAF
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en
