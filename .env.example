# ──────────────────────────────────────────────────────────────────────────
# HR Core — root .env (sample)
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` at the repository root and adjust each block.
# Both the KSM backend (Spring Boot, launched with `mvn spring-boot:run`)
# and the Next.js BFF read environment variables, so this file holds the
# union. The frontend ALSO loads `frontend/.env.local` (see that file for
# Next.js-only variables); root `.env` values are forwarded by the launch
# commands documented in README.md.
#
# After editing this file, source it before launching:
#   set -a; source .env; set +a; mvn -pl RT-comops-bootstrap -am spring-boot:run
#   (or pass `--env-file=.env` to your tooling)
# ──────────────────────────────────────────────────────────────────────────

# ==========================================================================
# 1. KSM Spring Boot — PostgreSQL connection
# ==========================================================================
# Default match the docker-compose dev infra (`KSM/docker-compose.infrastructure.yml`).
IWM_R2DBC_URL=r2dbc:postgresql://localhost:5432/iwm
IWM_R2DBC_USERNAME=iwm
IWM_R2DBC_PASSWORD=iwm

# Liquibase runs over JDBC (not R2DBC) — keep coordinates aligned with R2DBC.
IWM_LIQUIBASE_URL=jdbc:postgresql://localhost:5432/iwm
IWM_LIQUIBASE_USERNAME=iwm
IWM_LIQUIBASE_PASSWORD=iwm

# ==========================================================================
# 2. KSM Spring Boot — Redis (permission cache, quotas, sessions on BFF)
# ==========================================================================
IWM_REDIS_HOST=localhost
IWM_REDIS_PORT=6379
IWM_REDIS_PASSWORD=

# ==========================================================================
# 3. KSM Spring Boot — Elasticsearch / Kafka (OPTIONAL in dev)
# ==========================================================================
# Set ENABLED flags to false if you don't run these locally.
IWM_ELASTICSEARCH_URIS=http://localhost:9200
IWM_ELASTICSEARCH_HEALTH_ENABLED=false

IWM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
IWM_OUTBOX_RELAY_ENABLED=false
IWM_OUTBOX_REPLAY_ON_STARTUP_ENABLED=false

# ==========================================================================
# 4. KSM Spring Boot — JWT signing
# ==========================================================================
# `true` lets KSM generate an in-memory RSA key pair at boot (DEV ONLY).
# For production, provision a real key and set IWM_JWT_PRIVATE_KEY_PATH.
IWM_JWT_AUTO_GENERATE_KEY_PAIR=true
IWM_JWT_PRIVATE_KEY_PATH=
IWM_JWT_KEY_ID=iwm-key-1
IWM_JWT_ISSUER=iwm-backend

# ==========================================================================
# 5. KSM Spring Boot — management endpoints
# ==========================================================================
# Auth header to query /actuator/* in non-dev profiles.
IWM_MANAGEMENT_API_KEY=dev-management-api-key

# Optional override of the server port (default 8080).
# SERVER_PORT=8080

# ==========================================================================
# 6. Next.js BFF — KSM client credentials (server-only secrets)
# ==========================================================================
# Default value matches the ClientApplication seeded by V068__hrm_demo_seed.
# Rotate this for any non-demo deployment.
KSM_BASE_URL=http://localhost:8080
KSM_CLIENT_ID=hrm-frontend
KSM_API_KEY=hrm-bff-dev-secret-2024

# ==========================================================================
# 7. Next.js BFF — Session store (iron-session over Redis)
# ==========================================================================
# Generate a strong secret with:  openssl rand -hex 32
SESSION_COOKIE_NAME=hrm_session
SESSION_SECRET=replace-with-32-bytes-minimum-secret-here-please
SESSION_TTL_SECONDS=3600

# ==========================================================================
# 8. Next.js BFF — Outbound email (sender of welcome / notification mails)
# ==========================================================================
# EMAIL_PROVIDER values:
#   "none"   → log only (dev). Useful when you don't want to spam real inboxes.
#   "smtp"   → real SMTP via nodemailer (uses SMTP_HOST / SMTP_PORT / ...).
#   "resend" → Resend.com API (uses RESEND_API_KEY).
EMAIL_PROVIDER=none

# === SMTP backend (used when EMAIL_PROVIDER=smtp) ==========================
# Examples:
#   Gmail SMTP    : SMTP_HOST=smtp.gmail.com         SMTP_PORT=587 SMTP_SECURE=false
#   Mailtrap      : SMTP_HOST=sandbox.smtp.mailtrap.io SMTP_PORT=2525 SMTP_SECURE=false
#   AWS SES       : SMTP_HOST=email-smtp.eu-west-1.amazonaws.com SMTP_PORT=587 SMTP_SECURE=false
#   SendGrid      : SMTP_HOST=smtp.sendgrid.net       SMTP_PORT=587 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# === Resend backend (used when EMAIL_PROVIDER=resend) ======================
# Get a key at https://resend.com (free tier available).
RESEND_API_KEY=

# === Sender envelope (REQUIRED whatever provider you choose) ==============
#  EMAIL_FROM  → the `From:` header shown to recipients.
#                The format `"Display Name <inbox@domain>"` is supported.
#  EMAIL_REPLY_TO → optional `Reply-To:` header.
#
# IMPORTANT: with the `smtp` and `resend` providers, the sender domain MUST
# be verified by your provider:
#   - Resend: add and verify the domain in resend.com/domains.
#   - Gmail/Workspace SMTP: the FROM must be the authenticated mailbox.
#   - AWS SES: the FROM identity (or its domain) must be verified.
# Otherwise the mail will bounce or be marked as spam.
#
# In dev with EMAIL_PROVIDER=none the value is purely cosmetic (logs only).
EMAIL_FROM="HR Core <noreply@hrcore.local>"
EMAIL_REPLY_TO=

# ==========================================================================
# 8b. KSM backend — transactional emails (password reset / email verification)
# ==========================================================================
# These power the *backend* mails (Spring JavaMailSender), separate from the
# BFF welcome mail above. Defaults target Gmail SMTP; export these when you
# launch KSM (e.g. via `set -a; source .env; set +a`).
#
# Gmail prerequisites: enable 2-Step Verification, then create an "App password"
# (16 chars) at https://myaccount.google.com/apppasswords and use it below.
IWM_AUTH_EMAIL_ENABLED=false
IWM_MAIL_HOST=smtp.gmail.com
IWM_MAIL_PORT=587
# >>> your Gmail address (also used as the From identity)
IWM_MAIL_USERNAME=
# >>> your Gmail app password (16 chars)
IWM_MAIL_PASSWORD=
# >>> From header — must be the authenticated Gmail mailbox
IWM_AUTH_EMAIL_FROM=
# Base URL used to build reset/verify links (point to the frontend).
IWM_AUTH_EMAIL_PUBLIC_BASE_URL=http://localhost:3000

# ==========================================================================
# 9. Next.js public client config (exposed to the browser)
# ==========================================================================
NEXT_PUBLIC_APP_NAME=HR Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=XAF
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en

# ==========================================================================
# 10. Logging
# ==========================================================================
LOG_LEVEL=info
NODE_ENV=development
